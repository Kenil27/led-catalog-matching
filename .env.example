GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
SEARCH_MIN_SIMILARITY=0.6
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=catalog_products
CATALOG_PDF_DIR=./data/catalogs
EXTRACTED_DIR=./data/extracted
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_DIMENSION=8192
MIN_UPLOAD_DIMENSION=64

# Production (Vercel) — from npm run publish:assets
# CATALOG_JSON_URL=https://....blob.vercel-storage.com/led-catalog/catalog.json
# CATALOG_ASSET_BASE_URL=https://....blob.vercel-storage.com/led-catalog

# Local publish only
# BLOB_READ_WRITE_TOKEN=
# BLOB_PREFIX=led-catalog
# BLOB_STORE_ACCESS=public
# Use private if your Vercel Blob store is private:
# BLOB_STORE_ACCESS=private
